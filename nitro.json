{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["imeiserialreader"],
  "ios": {
    "iosModuleName": "ImeiSerialReader"
  },
  "android": {
    "androidNamespace": ["imeiserialreader"],
    "androidCxxLibName": "ImeiSerialReader"
  },
  "autolinking": {
    "OcrRecognizerFactory": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridOcrRecognizerFactory"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridOcrRecognizerFactory"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "**/example"]
}
